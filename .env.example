# LDAP connection used only by the separately deployed authentication gateway.
LDAP_URL=ldaps://your-ldap-host:636
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=uid=service-account,ou=people,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-me
LDAP_USER_SEARCH_FILTER=(uid={{username}})
LDAP_USER_ID_ATTRIBUTE=entryUUID
LDAP_USERNAME_ATTRIBUTE=uid

# The gateway holds AUTH_COOKIE_PRIVATE_KEY; DSH holds AUTH_COOKIE_PUBLIC_KEY.
# Store multiline PEM values in each process's credential store, not this file.
AUTH_COOKIE_ISSUER=https://auth.example.com
AUTH_COOKIE_AUDIENCE=dsh

# Gateway process settings. Registration creates a DSH-local account in
# DSH_AUTH_HOME/accounts.json; it never creates or modifies an LDAP entry.
DSH_AUTH_HOME=/var/lib/dsh-auth
# The DSH Host authentication boundary must read this same session directory.
DSH_AUTH_SESSION_DIRECTORY=/var/lib/dsh-auth/sessions
DSH_LOCAL_REGISTRATION_ENABLED=false
DSH_APP_URL=http://127.0.0.1:3080/
